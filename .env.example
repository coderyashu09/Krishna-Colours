# Environment Configuration for Krishna Colour - Asian Paints
# Centralized PostgreSQL connection (recommended for production)
# Format: postgresql+psycopg://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///krishna_colour.db

# Initial Admin Password (default is 1454 as specified)
INITIAL_ADMIN_PASSWORD=1454

# Application Secret Key for session signing
SECRET_KEY=krishna-colour-asian-paints-super-secret-key-change-in-production

# Session Timeout in minutes
SESSION_TIMEOUT_MINUTES=60

# Max Login Attempts before lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_TIME_MINUTES=15

# Shop Business Profile Defaults
SHOP_NAME="Krishna Colour – Asian Paints"
SHOP_TAGLINE="Authorized Dealer for Asian Paints"
SHOP_ADDRESS="Main Road, Near Bus Stand, Market Area"
SHOP_PHONE="+91 98765 43210"
SHOP_GSTIN="24AAAAA0000A1Z5"
SHOP_STATE="Gujarat (24)"
